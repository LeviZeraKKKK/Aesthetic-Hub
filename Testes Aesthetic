task.spawn(function()
	local steps = {
		{progress = 0.25, text = "Carregando módulos do Blox Fruits..."},
		{progress = 0.55, text = "Injetando sistemas ESP e Player..."},
		{progress = 0.85, text = "Sincronizando ambiente e texturas..."},
		{progress = 1.00, text = "Inicialização concluída com sucesso!"}
	}
	
	local currentTweenTime = 0.35
	for _, step in ipairs(steps) do
		loadStatus.Text = step.text
		TweenService:Create(loadBarFill, TweenInfo.new(currentTweenTime, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
			Size = UDim2.new(step.progress, 0, 1, 0)
		}):Play()
		
		local targetPercent = math.floor(step.progress * 100)
		percentLabel.Text = targetPercent .. "%"
		
		task.wait(currentTweenTime + 0.1)
	end
	
	if ringConn then ringConn:Disconnect() end
	task.wait(0.2)
	
	local fadeOut = TweenInfo.new(0.4, Enum.EasingStyle.Quad)
	TweenService:Create(loadWrapper, fadeOut, {BackgroundTransparency = 1}):Play()
	TweenService:Create(loadIcon, fadeOut, {TextTransparency = 1}):Play()
	TweenService:Create(loadTitle, fadeOut, {TextTransparency = 1}):Play()
	TweenService:Create(loadStatus, fadeOut, {TextTransparency = 1}):Play()
	TweenService:Create(percentLabel, fadeOut, {TextTransparency = 1}):Play()
	TweenService:Create(loadBarBg, fadeOut, {BackgroundTransparency = 1}):Play()
	TweenService:Create(loadBarFill, fadeOut, {BackgroundTransparency = 1}):Play()
	TweenService:Create(sciFiRing, fadeOut, {BackgroundTransparency = 1}):Play()
	
	task.wait(0.4)
	loadWrapper:Destroy()
	
	showMainPanel()
end)

