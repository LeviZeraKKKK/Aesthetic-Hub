-- RENDER LOOP (LÓGICA REAL DOS ESPs)
-----------------------------------------------------------------
local espDrawings = {}

RunService.RenderStepped:Connect(function()
	local char = player.Character
	if char and char:FindFirstChild("Humanoid") then
		if _G_WalkSpeedEnabled then char.Humanoid.WalkSpeed = _G_WalkSpeedValue end
		if _G_JumpPowerEnabled then char.Humanoid.JumpPower = _G_JumpPowerValue else char.Humanoid.JumpPower = 50 end
	end

	if _G_NoclipEnabled and char then
		for _, part in pairs(char:GetDescendants()) do
			if part:IsA("BasePart") then part.CanCollide = false end
		end
	end

	for _, targetPlayer in pairs(Players:GetPlayers()) do
		if targetPlayer ~= player then
			local tChar = targetPlayer.Character
			if _G_EspMaster and tChar and tChar:FindFirstChild("HumanoidRootPart") and tChar:FindFirstChild("Humanoid") and tChar.Humanoid.Health > 0 then
				local hrp = tChar.HumanoidRootPart
				local pos, onScreen = camera:WorldToViewportPoint(hrp.Position)

				if not espDrawings[targetPlayer] then
					espDrawings[targetPlayer] = {
						Box = Drawing.new("Square"),
						Line = Drawing.new("Line"),
						NameText = Drawing.new("Text"),
						DistText = Drawing.new("Text"),
						HeadDot = Drawing.new("Circle"),
						HealthBarBg = Drawing.new("Square"),
						HealthBarFill = Drawing.new("Square")
					}
				end

				local cache = espDrawings[targetPlayer]
				local head = tChar:FindFirstChild("Head")

				-- 1. Box ESP
				if _G_EspBox and onScreen then
					local headPos = head and camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or pos
					local legPos = camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
					local height = math.abs(headPos.Y - legPos.Y)
					local width = height / 1.8

					cache.Box.Size = Vector2.new(width, height)
					cache.Box.Position = Vector2.new(pos.X - width / 2, pos.Y - height / 2)
					cache.Box.Color = _G_ColorBox
					cache.Box.Thickness = 1
					cache.Box.Visible = true
				else
					cache.Box.Visible = false
				end

				-- 2. Line / Tracers ESP
				if _G_EspLine and onScreen then
					cache.Line.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
					cache.Line.To = Vector2.new(pos.X, pos.Y)
					cache.Line.Color = _G_ColorLine
					cache.Line.Thickness = 1
					cache.Line.Visible = true
				else
					cache.Line.Visible = false
				end

				-- 3. Chams (Highlight)
				local highlight = tChar:FindFirstChild("AetherisHighlight")
				if _G_EspChams then
					if not highlight then
						highlight = Instance.new("Highlight")
						highlight.Name = "AetherisHighlight"
						highlight.Parent = tChar
					end
					highlight.FillColor = _G_ColorChams
					highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
					highlight.Enabled = true
				elseif highlight then
					highlight.Enabled = false
				end

				-- 4. Health Bar
				if _G_EspHealth and onScreen then
					local hum = tChar.Humanoid
					local headPos = head and camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or pos
					local legPos = camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
					local height = math.abs(headPos.Y - legPos.Y)
					local width = height / 1.8

					local barHeight = height
					local currentHealthHeight = barHeight * (hum.Health / hum.MaxHealth)

					cache.HealthBarBg.Size = Vector2.new(3, barHeight)
					cache.HealthBarBg.Position = Vector2.new(pos.X - width / 2 - 6, pos.Y - height / 2)
					cache.HealthBarBg.Color = Color3.fromRGB(20, 20, 20)
					cache.HealthBarBg.Filled = true
					cache.HealthBarBg.Visible = true

					cache.HealthBarFill.Size = Vector2.new(1, currentHealthHeight)
					cache.HealthBarFill.Position = Vector2.new(pos.X - width / 2 - 5, pos.Y - height / 2 + (barHeight - currentHealthHeight))
					cache.HealthBarFill.Color = _G_ColorHealth
					cache.HealthBarFill.Filled = true
					cache.HealthBarFill.Visible = true
				else
					cache.HealthBarBg.Visible = false
					cache.HealthBarFill.Visible = false
				end

				-- 5. Name ESP
				if _G_EspName and onScreen then
					cache.NameText.Text = targetPlayer.Name
					cache.NameText.Size = 12
					cache.NameText.Center = true
					cache.NameText.Outline = true
					cache.NameText.Color = _G_ColorName
					cache.NameText.Position = Vector2.new(pos.X, pos.Y - 35)
					cache.NameText.Visible = true
				else
					cache.NameText.Visible = false
				end

				-- 6. Distance ESP
				if _G_EspDistance and onScreen then
					local dist = math.floor((camera.CFrame.Position - hrp.Position).Magnitude)
					cache.DistText.Text = "[" .. dist .. "m]"
					cache.DistText.Size = 11
					cache.DistText.Center = true
					cache.DistText.Outline = true
					cache.DistText.Color = _G_ColorDistance
					cache.DistText.Position = Vector2.new(pos.X, pos.Y + 25)
					cache.DistText.Visible = true
				else
					cache.DistText.Visible = false
				end

				-- 7. Head Dot ESP
				if _G_EspHead and head and onScreen then
					local headPos = camera:WorldToViewportPoint(head.Position)
					cache.HeadDot.Radius = 4
					cache.HeadDot.Position = Vector2.new(headPos.X, headPos.Y)
					cache.HeadDot.Color = _G_ColorHead
					cache.HeadDot.Filled = true
					cache.HeadDot.Visible = true
				else
					cache.HeadDot.Visible = false
				end
			else
				if espDrawings[targetPlayer] then
					espDrawings[targetPlayer].Box.Visible = false
					espDrawings[targetPlayer].Line.Visible = false
					espDrawings[targetPlayer].NameText.Visible = false
					espDrawings[targetPlayer].DistText.Visible = false
					espDrawings[targetPlayer].HeadDot.Visible = false
					espDrawings[targetPlayer].HealthBarBg.Visible = false
					espDrawings[targetPlayer].HealthBarFill.Visible = false
				end
				local hl = tChar and tChar:FindFirstChild("AetherisHighlight")
				if hl then hl.Enabled = false end
			end
		end
	end
end)
