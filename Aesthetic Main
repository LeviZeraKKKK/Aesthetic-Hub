		indicator.Size = UDim2.new(0, 2, 0, 0)
		indicator.Position = UDim2.new(0, 0, 0.5, 0)
		indicator.AnchorPoint = Vector2.new(0, 0.5)
		indicator.BackgroundColor3 = currentThemeColor
		indicator.BorderSizePixel = 0
		indicator.Parent = tabButton

		local indCorner = Instance.new("UICorner")
		indCorner.CornerRadius = UDim.new(1, 0)
		indCorner.Parent = indicator

		tabIndicators[tabButton] = indicator
		
		local page = createPage(tabInfo.Name)

		tabButton.MouseButton1Click:Connect(function()
			if activePage == page then return end
			
			for _, p in pairs(pages) do 
				if p.Visible then
					TweenService:Create(p, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {Position = UDim2.new(-1, 0, 0, 4)}):Play()
					task.wait(0.15)
					p.Visible = false
				end
			end

			page.Visible = true
			page.Position = UDim2.new(1, 0, 0, 4)
			TweenService:Create(page, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, 4, 0, 4)}):Play()

			for btn, ind in pairs(tabIndicators) do
				TweenService:Create(ind, TweenInfo.new(0.15), {Size = UDim2.new(0, 2, 0, 0)}):Play()
				TweenService:Create(btn, TweenInfo.new(0.15), {TextColor3 = Color3.fromRGB(180, 180, 180)}):Play()
			end

			TweenService:Create(indicator, TweenInfo.new(0.15), {Size = UDim2.new(0, 2, 0, 16)}):Play()
			TweenService:Create(tabButton, TweenInfo.new(0.15), {TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()

			activePage = page
		end)

		if i == 1 then
			page.Visible = true
			page.Position = UDim2.new(0, 4, 0, 4)
			activePage = page
			indicator.Size = UDim2.new(0, 2, 0, 16)
			tabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
		end
	end

